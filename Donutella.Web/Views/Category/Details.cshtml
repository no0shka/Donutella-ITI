@model Donutella.Web.Models.ViewModels.Category.CategoryViewModel

@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

<div class="card">
    <div class="card-body">

        <h5 class="card-title">
            @Model.Name
        </h5>

        <p class="card-text">
            @Model.Description
        </p>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>
