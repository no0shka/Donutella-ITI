<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Donutella</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                background-color: #fff;
                color: #212529;
            }

            /* =========================
                       NAVBAR
                    ========================= */

            .donutella-navbar {
                background: #ffffff;
                box-shadow: 0 2px 15px rgba(0,0,0,0.06);
                padding: 15px 0;
            }

            .brand-logo {
                font-size: 1.7rem;
                font-weight: 800;
                color: #dc3545 !important;
                letter-spacing: 1px;
            }

            .nav-link {
                color: #343a40 !important;
                font-weight: 500;
                margin: 0 8px;
                transition: 0.3s;
            }

                .nav-link:hover {
                    color: #dc3545 !important;
                }

            .navbar-icon-btn {
                border: 1px solid #dee2e6;
                border-radius: 50px;
                padding: 8px 15px;
                text-decoration: none;
                color: #212529;
                transition: 0.3s;
            }

                .navbar-icon-btn:hover {
                    background: #dc3545;
                    color: white;
                    border-color: #dc3545;
                }

            .login-btn {
                background: #212529;
                color: white !important;
                border-radius: 25px;
                padding: 8px 20px !important;
            }

                .login-btn:hover {
                    background: #dc3545;
                }


            /* =========================
                       FOOTER
                    ========================= */

            .donutella-footer {
                background: #212529;
                color: white;
                margin-top: 80px;
            }

            .footer-brand {
                color: #ff6b81;
                font-size: 1.8rem;
                font-weight: 800;
            }

            .footer-title {
                font-weight: 700;
                margin-bottom: 20px;
            }

            .footer-link {
                color: #adb5bd;
                text-decoration: none;
                display: block;
                margin-bottom: 10px;
                transition: 0.3s;
            }

                .footer-link:hover {
                    color: #ff6b81;
                    padding-left: 5px;
                }

            .footer-bottom {
                border-top: 1px solid #495057;
                padding: 20px 0;
                color: #adb5bd;
            }

    </style>
</head>

<body>

    <!-- =========================
         NAVBAR
    ========================= -->

    <nav class="navbar navbar-expand-lg donutella-navbar sticky-top">

        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand brand-logo"
               asp-controller="Home"
               asp-action="Index">

                🍩 Donutella

            </a>


            <!-- Mobile Button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#donutellaNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Navbar Content -->
            <div class="collapse navbar-collapse"
                 id="donutellaNavbar">

                <!-- Links -->
                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Store"
                           asp-action="Products">

                            Shop

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Wishlist"
                           asp-action="Index">

                            <i class="bi bi-heart"></i> Wishlist

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Cart"
                           asp-action="Index">

                            <i class="bi bi-cart"></i> Cart

                        </a>

                    </li>

                </ul>


                <!-- Right Side -->
               


@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="User"
       asp-action="Profile"
       class="nav-link">
        Profile
    </a>

    <a asp-controller="Account"
       asp-action="Logout"
       class="nav-link">
        Logout
    </a>
}
else
{
    <a asp-controller="Account"
       asp-action="Login"
       class="nav-link">
        Login
    </a>

    <a asp-controller="Account"
       asp-action="Register"
       class="nav-link">
        Register
    </a>
}

                </div>

            </div>

        </div>

    </nav>


    <!-- =========================
         PAGE CONTENT
    ========================= -->

    <main>
        @RenderBody()
    </main>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer class="donutella-footer">

        <div class="container py-5">

            <div class="row g-5">

                <!-- About -->
                <div class="col-lg-4">

                    <div class="footer-brand mb-3">
                        🍩 Donutella
                    </div>

                    <p class="text-white-50">

                        Sweet moments made delicious.
                        Discover fresh cakes, donuts, cupcakes
                        and desserts made with love.

                    </p>

                    <div class="mt-4">

                        <span class="me-3 fs-5">📘</span>
                        <span class="me-3 fs-5">📸</span>
                        <span class="me-3 fs-5">💬</span>

                    </div>

                </div>


                <!-- Quick Links -->
                <div class="col-lg-2 col-md-4">

                    <h5 class="footer-title">
                        Quick Links
                    </h5>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="footer-link">

                        Home

                    </a>

                    <a asp-controller="Store"
                       asp-action="Products"
                       class="footer-link">

                        Shop

                    </a>

                    <a asp-controller="Wishlist"
                       asp-action="Index"
                       class="footer-link">

                        Wishlist

                    </a>

                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="footer-link">

                        Cart

                    </a>

                </div>


                <!-- Customer -->
                <div class="col-lg-3 col-md-4">

                    <h5 class="footer-title">
                        Customer Care
                    </h5>

                    <a href="#" class="footer-link">
                        Contact Us
                    </a>

                    <a href="#" class="footer-link">
                        Delivery Information
                    </a>

                    <a href="#" class="footer-link">
                        Privacy Policy
                    </a>

                    <a href="#" class="footer-link">
                        Terms & Conditions
                    </a>

                </div>


                <!-- Contact -->
                <div class="col-lg-3 col-md-4">

                    <h5 class="footer-title">
                        Get In Touch
                    </h5>

                    <p class="text-white-50 mb-2">
                        📍 Egypt
                    </p>

                    <p class="text-white-50 mb-2">
                        📞 +20 100 000 0000
                    </p>

                    <p class="text-white-50">
                        ✉️ hello@donutella.com
                    </p>

                </div>

            </div>

        </div>


        <!-- Bottom -->
        <div class="footer-bottom">

            <div class="container">

                <div class="row align-items-center">

                    <div class="col-md-6">

                        © @DateTime.Now.Year Donutella.
                        All Rights Reserved.

                    </div>

                    <div class="col-md-6 text-md-end">

                        Made with ❤️ for dessert lovers.

                    </div>

                </div>

            </div>

        </div>

    </footer>


    <!-- Chatbot Widget -->

    @await Html.PartialAsync("_ChatBot")


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
