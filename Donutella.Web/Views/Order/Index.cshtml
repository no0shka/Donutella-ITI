@model IEnumerable<Donutella.Domain.Entities.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">My Orders</h1>
        <p class="text-muted">Track your orders</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">You have no orders yet.</div>
        <div class="text-center">
            <a asp-controller="Store" asp-action="Products" class="btn btn-primary">Shop Now</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h5 class="fw-bold mb-0">Order #@order.Id</h5>
                        <span class="badge @(order.Status == OrderStatus.Cancelled ? "bg-danger" : order.Status == OrderStatus.Pending ? "bg-warning text-dark" : "bg-success")">
                            @order.Status
                        </span>
                    </div>
                    <p class="text-muted small mb-3">@order.OrderDate.ToLocalTime().ToString("g")</p>

                    <div class="d-flex flex-wrap gap-3 mb-3">
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="d-flex gap-2 align-items-center">
                                @if (!string.IsNullOrEmpty(item.Product?.Image))
                                {
                                    <img src="@item.Product!.Image"
                                         alt="@(item.Product?.Name ?? "Product")"
                                         class="rounded"
                                         style="width:60px; height:60px; object-fit:cover;" />
                                }
                                <div>
                                    <div class="fw-bold small">@(item.Product?.Name ?? $"Product #{item.ProductId}")</div>
                                    <div class="text-muted small">x @item.Quantity</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-primary mb-0">@order.TotalPrice.ToString("C")</h5>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">Details</a>
                            @if (order.Status == OrderStatus.Pending)
                            {
                                <form asp-action="Cancel" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Cancel this order?');">Cancel</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
