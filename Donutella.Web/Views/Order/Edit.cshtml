@model Donutella.Domain.Entities.Order

@{
    ViewData["Title"] = $"Edit Order #{Model.Id}";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Edit Order #@Model.Id</h1>
        <p class="text-muted">Admin: review the order and update its status</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Customer Details</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted d-block">Customer</small>
                    <span class="fw-semibold">@Model.CustomerName</span>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Phone</small>
                    <span class="fw-semibold">@Model.Phone</span>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Address</small>
                    <span class="fw-semibold">@Model.Address</span>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Date</small>
                    <span class="fw-semibold">@Model.OrderDate.ToLocalTime().ToString("g")</span>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Status</small>
                    <span class="badge @(Model.Status == OrderStatus.Cancelled ? "bg-danger" : Model.Status == OrderStatus.Pending ? "bg-warning text-dark" : "bg-success")">
                        @Model.Status
                    </span>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Total</small>
                    <span class="fw-bold text-primary">@Model.TotalPrice.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Items</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td style="width:80px;">
                                    @if (!string.IsNullOrEmpty(item.Product?.Image))
                                    {
                                        <img src="@item.Product!.Image"
                                             alt="@(item.Product?.Name ?? "Product")"
                                             class="rounded"
                                             style="width:60px; height:60px; object-fit:cover;" />
                                    }
                                </td>
                                <td class="fw-bold">@(item.Product?.Name ?? $"Product #{item.ProductId}")</td>
                                <td>@item.Price.ToString("C")</td>
                                <td>@item.Quantity</td>
                                <td>@((item.Price * item.Quantity).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Update Status</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" class="row g-3 align-items-end">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-6">
                    <label for="status" class="form-label fw-semibold">Status</label>
                    <select name="status" id="status" class="form-select">
                        @foreach (var s in Enum.GetValues<OrderStatus>())
                        {
                            if (s == Model.Status)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Manage" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
