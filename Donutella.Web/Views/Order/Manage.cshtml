@model IEnumerable<Donutella.Domain.Entities.Order>

@{
    ViewData["Title"] = "Manage Orders";
    var currentEmail = (string?)ViewBag.Email;
    var currentStatus = (OrderStatus?)ViewBag.Status;
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Manage Orders</h1>
        <p class="text-muted">Admin: view and update all orders</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <form asp-action="Manage" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="email" class="form-label fw-semibold">Search by user email</label>
                    <input type="text" name="email" id="email" value="@currentEmail"
                           class="form-control" placeholder="e.g. user@mail.com" />
                </div>
                <div class="col-md-4">
                    <label for="status" class="form-label fw-semibold">Status</label>
                    <select name="status" id="status" class="form-select">
                        @if (currentStatus is null)
                        {
                            <option value="" selected>All</option>
                        }
                        else
                        {
                            <option value="">All</option>
                        }
                        @foreach (var s in Enum.GetValues<OrderStatus>())
                        {
                            if (s == currentStatus)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">Search</button>
                    <a asp-action="Manage" class="btn btn-outline-secondary flex-fill">Clear</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">No orders found.</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Customer</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Items</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@order.Id</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.User?.Email</td>
                                    <td>@order.Phone</td>
                                    <td class="text-muted small">@order.OrderDate.ToLocalTime().ToString("g")</td>
                                    <td>
                                        <span class="badge @(order.Status == OrderStatus.Cancelled ? "bg-danger" : order.Status == OrderStatus.Pending ? "bg-warning text-dark" : "bg-success")">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="fw-bold text-primary">@order.TotalPrice.ToString("C")</td>
                                    <td>@order.OrderItems.Count</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-warning">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
