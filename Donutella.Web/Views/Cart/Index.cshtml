@model Donutella.Domain.Entities.Cart

@{
    ViewData["Title"] = "My Cart";
    decimal total = 0;
    if (Model?.CartItems != null)
    {
        foreach (var i in Model.CartItems)
            total += (i.Product?.Price ?? 0) * i.Quantity;
    }
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">My Cart</h1>
        <p class="text-muted">Review your items before checkout</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model == null || !Model.CartItems.Any())
    {
        <div class="text-center py-5">
            <h3 class="mt-3">Your Cart is Empty</h3>
            <p class="text-muted">Add some delicious products to your cart.</p>
            <a asp-controller="Store" asp-action="Products" class="btn btn-dark mt-3">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @foreach (var item in Model.CartItems)
                {
                    var subtotal = (item.Product?.Price ?? 0) * item.Quantity;
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <div class="row g-3 align-items-center">
                                <div class="col-auto">
                                    @if (!string.IsNullOrEmpty(item.Product?.Image))
                                    {
                                        <img src="@item.Product!.Image"
                                             alt="@(item.Product?.Name ?? "Product")"
                                             class="rounded"
                                             style="width:110px; height:110px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center text-muted"
                                             style="width:110px; height:110px;">
                                            No image
                                        </div>
                                    }
                                </div>

                                <div class="col">
                                    <h5 class="card-title fw-bold mb-1">
                                        @(item.Product?.Name ?? $"Product #{item.ProductId}")
                                    </h5>
                                    <p class="text-muted small mb-2">
                                        @((item.Product?.Price ?? 0).ToString("C")) each
                                    </p>
                                    <div class="d-flex align-items-center gap-2">
                                        <form asp-action="Decrease" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary px-3 fw-bold">-</button>
                                        </form>
                                        <span class="fw-bold px-1">@item.Quantity</span>
                                        <form asp-action="Increase" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary px-3 fw-bold">+</button>
                                        </form>
                                    </div>
                                </div>

                                <div class="col-auto text-end">
                                    <h5 class="fw-bold text-primary mb-2">@subtotal.ToString("C")</h5>
                                    <form asp-action="Remove" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Remove this item?');">Remove</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Total</span>
                            <h5 class="fw-bold text-primary mb-0">@total.ToString("C")</h5>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-action="Checkout" class="btn btn-success">Checkout</a>
                            <a asp-controller="Store" asp-action="Products"
                               class="btn btn-outline-secondary">Continue Shopping</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
