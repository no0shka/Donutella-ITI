@{
    ViewData["Title"] = "نسيت كلمة المرور";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="text-center">استعادة كلمة المرور</h3>
            </div>
            <div class="card-body">
                <p class="text-muted text-center">أدخل بريدك الإلكتروني المسجل وسنرسل لك رابط لإعادة تعيين كلمة المرور</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post" asp-action="ForgotPassword">
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني</label>
                        <input type="email" name="email" class="form-control" required autocomplete="email" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">إرسال رابط الاستعادة</button>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="Login">العودة لتسجيل الدخول</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}