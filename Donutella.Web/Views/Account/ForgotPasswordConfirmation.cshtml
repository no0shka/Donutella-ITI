@{
    ViewData["Title"] = "تحقق من بريدك الإلكتروني";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="text-center">تحقق من بريدك الإلكتروني</h3>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <svg class="text-success" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-3.75a.75.75 0 0 0-.082-1.01z"/>
                    </svg>
                </div>
                
                <h4 class="mb-3">تم إرسال رابط الاستعادة</h4>
                
                @if (ViewBag.Message != null)
                {
                    <div class="alert @(ViewBag.Success == true ? "alert-success" : "alert-info")">
                        @ViewBag.Message
                    </div>
                }

                <p class="text-muted">
                    إذا كان البريد الإلكتروني <strong>@ViewBag.Email</strong> مسجلاً في نظامنا، 
                    ستتلقى رسالة تحتوي على رابط لإعادة تعيين كلمة المرور خلال بضع دقائق.
                </p>

                <p class="text-muted small">
                    لم تستلم الرسالة؟ تحقق من مجلد الرسائل المزعجة (Spam) أو 
                    <a asp-action="ForgotPassword">أعد المحاولة</a>
                </p>

                <div class="mt-4">
                    <a asp-action="Login" class="btn btn-primary">العودة لتسجيل الدخول</a>
                </div>
            </div>
        </div>
    </div>
</div>