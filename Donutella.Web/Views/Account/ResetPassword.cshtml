@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="text-center">تعيين كلمة مرور جديدة</h3>
            </div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post" asp-action="ResetPassword">
                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    <div class="mb-3">
                        <label class="form-label">كلمة المرور الجديدة</label>
                        <input type="password" name="newPassword" class="form-control" required autocomplete="new-password" minlength="6" />
                        <div class="form-text">كلمة المرور يجب أن تكون 6 أحرف على الأقل</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">تأكيد كلمة المرور الجديدة</label>
                        <input type="password" name="confirmPassword" class="form-control" required autocomplete="new-password" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success">تعيين كلمة المرور</button>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="Login">العودة لتسجيل الدخول</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}