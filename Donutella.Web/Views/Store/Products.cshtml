@model IEnumerable<Donutella.Web.Models.ViewModels.Product.ProductViewModel>

@{
    ViewData["Title"] = "Our Products";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Our Products</h1>
        <p class="text-muted">
            Discover our delicious collection of desserts
        </p>
    </div>

    <div class="row g-4">

        @foreach (var product in Model)
        {
            <div class="col-md-6 col-lg-4 col-xl-3">

                <div class="card h-100 shadow-sm border-0">

                    <img src="@product.Image"
                         class="card-img-top"
                         alt="@product.Name"
                         style="height:250px; object-fit:cover;" />

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title fw-bold">
                            @product.Name
                        </h5>

                        <p class="text-muted small">
                            @product.Description
                        </p>

                        <p class="mb-2">
                            <strong>Category:</strong>
                            @product.SubCategoryName
                        </p>

                        <h5 class="text-primary mb-3">
                            @product.Price.ToString("C")
                        </h5>

                        <div class="mt-auto d-grid gap-2">
                            <a asp-controller="Store"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-primary w-100 mb-2">
                                View Details
                            </a>

                            <form asp-controller="Cart"
                                  asp-action="Add"
                                  method="post">
                                <input type="hidden"
                                       name="productId"
                                       value="@product.Id" />
                                <input type="hidden"
                                       name="returnUrl"
                                       value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                @if (product.Stock > 0)
                                {
                                    <button type="submit"
                                            class="btn btn-success w-100">
                                        Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary w-100"
                                            disabled>
                                        Out of Stock
                                    </button>
                                }
                            </form>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
