@model Donutella.Web.Models.ViewModels.Product.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>

<form asp-action="SaveEdit"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>


    <div class="mb-3">
        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>


    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
        </label>

        <textarea asp-for="Description"
                  class="form-control"></textarea>

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>


    <div class="mb-3">
        <label asp-for="Price"
               class="form-label">
        </label>

        <input asp-for="Price"
               class="form-control" />

        <span asp-validation-for="Price"
              class="text-danger">
        </span>
    </div>


    <div class="mb-3">
        <label asp-for="Stock"
               class="form-label">
        </label>

        <input asp-for="Stock"
               class="form-control" />

        <span asp-validation-for="Stock"
              class="text-danger">
        </span>
    </div>


    <div class="mb-3">
        <label asp-for="SubCategoryId"
               class="form-label">
            SubCategory
        </label>

        <select asp-for="SubCategoryId"
                asp-items="Model.SubCategories"
                class="form-select">

            <option value="">
                -- Select SubCategory --
            </option>

        </select>

        <span asp-validation-for="SubCategoryId"
              class="text-danger">
        </span>
    </div>


    <!-- Current Main Image -->
    @if (!string.IsNullOrEmpty(Model.Image))
    {
        <div class="mb-3">
            <label class="form-label">
                Current Main Image
            </label>

            <div>
                <img src="@Model.Image"
                     alt="@Model.Name"
                     width="150"
                     height="150"
                     style="object-fit: cover;" />
            </div>
        </div>
    }


    <!-- New Main Image -->
    <div class="mb-3">
        <label asp-for="MainImageFile"
               class="form-label">
            Change Main Image
        </label>

        <input asp-for="MainImageFile"
               type="file"
               class="form-control"
               accept="image/*" />

        <span asp-validation-for="MainImageFile"
              class="text-danger">
        </span>
    </div>


    <!-- More Images -->
    <div class="mb-3">
        <label asp-for="ImageFiles"
               class="form-label">
            Add More Images
        </label>

        <input asp-for="ImageFiles"
               type="file"
               class="form-control"
               multiple
               accept="image/*" />

        <span asp-validation-for="ImageFiles"
              class="text-danger">
        </span>
    </div>


    <!-- Existing More Images -->
    @if (Model.ProductImages.Any())
    {
        <div class="mb-4">

            <h4>Current More Images</h4>

            <div class="d-flex flex-wrap gap-3">

                @foreach (var image in Model.ProductImages)
                {
                    <img src="@image"
                         alt="@Model.Name"
                         width="120"
                         height="120"
                         style="object-fit: cover;" />
                }

            </div>

        </div>
    }


    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}