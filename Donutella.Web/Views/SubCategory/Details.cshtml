@model Donutella.Web.Models.ViewModels.SubCategory.SubCategoryViewModel

@{
    ViewData["Title"] = "SubCategory Details";
}

<div class="container mt-4">

    <h1>SubCategory Details</h1>

    <div class="card mt-4">

        <div class="card-body">

            <div class="mb-3">
                <strong>Id:</strong>
                <span>@Model.Id</span>
            </div>

            <div class="mb-3">
                <strong>Name:</strong>
                <span>@Model.Name</span>
            </div>

            <div class="mb-3">
                <strong>Description:</strong>
                <span>@Model.Description</span>
            </div>

            <div class="mb-3">
                <strong>Category:</strong>
                <span>@Model.CategoryName</span>
            </div>

        </div>

    </div>

    <div class="mt-3">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger">
            Delete
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>